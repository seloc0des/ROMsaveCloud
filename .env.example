# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated on each restart (all tokens invalidated).
OSGSC_SECRET_KEY=

OSGSC_PORT=4444
OSGSC_MAX_SAVE_SIZE_MB=50
OSGSC_MAX_VERSIONS=5

# Optional: restrict CORS to specific origins (comma-separated)
# OSGSC_CORS_ORIGINS=https://my-domain.com,http://localhost:3000
